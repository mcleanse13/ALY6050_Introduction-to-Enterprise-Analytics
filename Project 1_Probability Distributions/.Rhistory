N <- 10000
r <- runif(N)
x <- -log(r)
hist(x, freq=F)
lines(density(x), lwd=1.5, col='red')
summary(x)
sd(x)
library(e1071)
skewness(x)
Emp_mean <- mean(x)
y <- rexp(N, rate = 1/Emp_mean)
qqplot(x,y)
abline(0,1,lwd=2,col="red")
N1 <- 10000
r1 <- runif(N)
x1 <- -log(r1)
hist(x1, freq=F)
lines(density(x1), lwd=1.5, col='red')
summary(x1)
sd(x1)
library(e1071)
skewness(x1)
N2 <- 10000
r2 <- runif(N)
x2 <- -log(r2)
hist(x2, freq=F)
lines(density(x2), lwd=1.5, col='red')
summary(x2)
sd(x2)
library(e1071)
skewness(x2)
N3 <- 10000
r3<- runif(N3)
x3 <- -log(r3)
hist(x3, freq=F)
lines(density(x3), lwd=1.5, col='red')
summary(x3)
sd(x3)
library(e1071)
skewness(x3)
Emp_mean <- mean(x1)
y1 <- rexp(N1, rate = 1/Emp_mean)
qqplot(x1,y1)
abline(0,1,lwd=2,col="red")
Emp_mean1 <- mean(x1)
y1 <- rexp(N1, rate = 1/Emp_mean1)
qqplot(x1,y1)
abline(0,1,lwd=2,col="red")
Emp_mean2 <- mean(x2)
y2 <- rexp(N2, rate = 1/Emp_mean2)
qqplot(x2,y2)
abline(0,1,lwd=2,col="red")
Emp_mean3 <- mean(x3)
y3 <- rexp(N3, rate = 1/Emp_mean3)
qqplot(x3,y3)
abline(0,1,lwd=2,col="red")
x <- -log(r1, r2, r3)
hist(x, freq=F)
lines(density(x), lwd=1.5, col='red')
summary(x)
sd(x)
library(e1071)
skewness(x)
x <- -log(r1*r2*r3)
hist(x, freq=F)
lines(density(x), lwd=1.5, col='red')
summary(x)
sd(x)
library(e1071)
skewness(x)
